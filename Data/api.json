{
  "asr": {
    "batch_size": 1,
    "device": "cpu",
    "disable_pbar": true,
    "disable_update": true,
    "input_device": null,
    "local_files_only": true,
    "max_single_segment_length": 20000,
    "model": "models/SenseVoiceSmall",
    "vad_model": "fsmn-vad"
  },
  "llm": {
    "main": {
      "api_base": "http://127.0.0.1:1234/v1",
      "api_key": "env:ALI_API",
      "model_name": "qwen3.5-0.8b"
    },
    "main_cuda": {
      "api_base": "https://dashscope.aliyuncs.com/api/v1",
      "api_key": "env:ALI_API",
      "model_name": "qwen3.5-flash"
    },
    "memory": {
      "api_base": "http://127.0.0.1:1234/v1",
      "api_key": "env:ALI_API",
      "model_name": "qwen/qwen3-vl-4b"
    },
    "omni": {
      "api_base": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "api_key": "env:ALI_API",
      "model_name": "qwen3.7-flash"
    }
  },
  "system": {
    "enable_ui": false,
    "enable_ws": true,
    "log_level": "INFO",
    "make_memory": 16,
    "silence_timeout": 60,
    "ws_host": "127.0.0.1",
    "ws_port": 8765
  },
  "tts": {
    "ali": {
      "api_key": "env:ALI_API",
      "model": "cosyvoice-v1",
      "sample_rate": 24000,
      "voice": "longmiao"
    },
    "edge": {
      "max_workers": 3,
      "rate": "+15%",
      "voice": "zh-CN-XiaoxiaoNeural"
    },
    "lux": {
      "max_workers": 1,
      "num_steps": 2,
      "threads": 6
    },
    "engine": "lux"
  },
  "vad": {
    "max_duration": 30,
    "max_silence_blocks": 1,
    "model_path": "models/vosk-model-small-cn-0.22",
    "pre_roll_seconds": 1,
    "sample_rate": 12000
  }
}
